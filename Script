/* =========================================================
   EFFECTS
========================================================= */

window.setEffect = function (effect) {

    currentEffect = effect;

    drawFrame();

    setStatus(
        exportStatus,
        "🎨 Effect: " + effect
    );
};


function getFilter() {

    const amount =
        Number(effectAmount.value);

    switch (currentEffect) {

        case "grayscale":
            return `grayscale(${amount}%)`;

        case "sepia":
            return `sepia(${amount}%)`;

        case "invert":
            return `invert(${amount}%)`;

        case "blur":
            return `blur(${amount / 35}px)`;

        case "brightness":
            return `brightness(${amount}%)`;

        case "contrast":
            return `contrast(${amount}%)`;

        case "saturate":
            return `saturate(${amount}%)`;

        case "vintage":
            return `
                sepia(45%)
                contrast(120%)
                saturate(80%)
            `;

        case "glow":
            return `
                brightness(115%)
                saturate(140%)
                contrast(105%)
            `;

        default:
            return "none";
    }
}


