/* =========================================================
   HELPER
========================================================= */

function setStatus(element, text) {
    if (element) {
        element.textContent = text;
    }
}

function setProgress(value) {

    value = Math.max(
        0,
        Math.min(100, value)
    );

    progressBar.style.width =
        value + "%";
}

function wait(ms) {
    return new Promise(
        resolve => setTimeout(resolve, ms)
    );
}


/* =========================================================
   VIDEO UPLOAD
========================================================= */

videoInput.addEventListener(
    "change",
    async function () {

        const file = this.files[0];

        if (!file) {
            return;
        }

        videoFile = file;

        if (videoURL) {
            URL.revokeObjectURL(videoURL);
        }

        videoURL =
            URL.createObjectURL(file);

        sourceVideo.src = videoURL;

        sourceVideo.load();

        sourceVideo.onloadedmetadata =
            function () {

                const width =
                    sourceVideo.videoWidth;

                const height =
                    sourceVideo.videoHeight;

                /*
                   Canvas dimensions should preferably
                   be even because H.264 requires
                   even dimensions.
                */

                canvas.width =
                    width % 2 === 0
                        ? width
                        : width - 1;

                canvas.height =
                    height % 2 === 0
                        ? height
                        : height - 1;

                setStatus(
                    videoStatus,
                    "✅ Video loaded: " +
                    canvas.width +
                    " × " +
                    canvas.height +
                    " | " +
                    sourceVideo.duration.toFixed(1) +
                    " sec"
                );

                sourceVideo.currentTime = 0;

                drawFrame();
            };
    }
);


