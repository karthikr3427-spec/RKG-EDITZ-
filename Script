/* =========================================================
   LIVE VIDEO PREVIEW
========================================================= */

sourceVideo.addEventListener(
    "play",
    function () {

        if (animationID) {
            cancelAnimationFrame(animationID);
        }

        function loop() {

            drawFrame();

            if (!sourceVideo.paused &&
                !sourceVideo.ended) {

                animationID =
                    requestAnimationFrame(loop);
            }
        }

        loop();
    }
);

sourceVideo.addEventListener(
    "pause",
    function () {

        if (animationID) {

            cancelAnimationFrame(
                animationID
            );

            animationID = null;
        }

        drawFrame();
    }
);

sourceVideo.addEventListener(
    "seeked",
    drawFrame
);


/* =========================================================
   LOAD FFMPEG
========================================================= */

async function loadFFmpeg() {

    if (ffmpegLoaded) {
        return;
    }

    setStatus(
        exportStatus,
        "⏳ MP4 engine loading... First time ಸ್ವಲ್ಪ time ಬೇಕು."
    );

    ffmpeg =
        new FFmpeg();

    ffmpeg.on(
        "progress",
        function ({ progress }) {

            if (!exporting) {
                return;
            }

            const percent =
                Math.round(
                    progress * 100
                );

            /*
              FFmpeg conversion progress.
              Keep it below 100 until complete.
            */

            setProgress(
                Math.min(99, percent)
            );

            setStatus(
                exportStatus,
                "⚙️ MP4 conversion: " +
                percent +
                "%"
            );
        }
    );

    ffmpeg.on(
        "log",
        function ({ message }) {

            console.log(
                "[FFmpeg]",
                message
            );
        }
    );

    const baseURL =
        "https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.10/dist/esm";

    const coreURL =
        await toBlobURL(
            `${baseURL}/ffmpeg-core.js`,
            "text/javascript"
        );

    const wasmURL =
        await toBlobURL(
            `${baseURL}/ffmpeg-core.wasm`,
            "application/wasm"
        );

    await ffmpeg.load({
        coreURL,
        wasmURL
    });

    ffmpegLoaded = true;

    setStatus(
        exportStatus,
        "✅ MP4 engine ready"
    );
}


/* =========================================================
   RECORD CANVAS + AUDIO
========================================================= */

async function createEditedVideo() {

    if (!videoFile) {
        throw new Error(
            "First video upload madi."
        );
    }

    /*
      Canvas recording.
      30 FPS is a good balance for mobile.
    */

    const fps = 30;

    const canvasStream =
        canvas.captureStream(fps);

    /*
      Audio capture.
      Use AudioContext so the uploaded
      music can become a MediaStream track.
    */

    let audioContext = null;
    let audioDestination = null;
    let audioSource = null;
    let audioGain = null;

    let audioStream = null;

    if (musicFile) {

        audioContext =
            new (
                window.AudioContext ||
                window.webkitAudioContext
            )();

        audioDestination =
            audioContext.createMediaStreamDestination();

        audioSource =
            audioContext.createMediaElementSource(
                music
            );

        audioGain =
            audioContext.createGain();

        audioGain.gain.value =
            Number(musicVolume.value);

        audioSource.connect(
            audioGain
        );

        /*
          Send audio to phone speaker/headphones
          and to recorder.
        */

        audioGain.connect(
            audioContext.destination
        );

        audioGain.connect(
            audioDestination
        );

        audioStream =
            audioDestination.stream;
    }


    /*
      Combine video canvas stream
      with music stream.
    */

    const combinedStream =
        new MediaStream();

    canvasStream
        .getVideoTracks()
        .forEach(
            track =>
                combinedStream.addTrack(track)
        );

    if (audioStream) {

        audioStream
            .getAudioTracks()
            .forEach(
                track =>
                    combinedStream.addTrack(track)
            );
    }


    /*
      Chrome normally supports WebM recording.
      FFmpeg later converts WebM -> MP4.
    */

    let mimeType = "";

    const candidates = [
        "video/webm;codecs=vp9",
        "video/webm;codecs=vp8",
        "video/webm"
    ];

    for (const type of candidates) {

        if (
            MediaRecorder.isTypeSupported(
                type
            )
        ) {

            mimeType = type;
            break;
        }
    }

    if (!mimeType) {

        throw new Error(
            "Your browser does not support video recording."
        );
    }


    const recorder =
        new MediaRecorder(
            combinedStream,
            {
                mimeType,
                videoBitsPerSecond: 6_000_000
            }
        );


    const chunks = [];

    recorder.ondataavailable =
        function (event) {

            if (
                event.data &&
                event.data.size > 0
            ) {

                chunks.push(
                    event.data
                );
            }
        };


    const finished =
        new Promise(
            (resolve, reject) => {

                recorder.onerror =
                    function (event) {

                        reject(
                            event.error ||
                            new Error(
                                "Recording failed."
                            )
                        );
                    };

                recorder.onstop =
                    function () {

                        resolve(
                            new Blob(
                                chunks,
                                {
                                    type:
                                        mimeType
                                }
                            )
                        );
                    };
            }
        );


    /*
      Reset playback.
    */

    sourceVideo.pause();
    sourceVideo.currentTime = 0;

    if (musicFile) {

        music.pause();
        music.currentTime = 0;
        music.volume =
            Number(musicVolume.value);

        if (
            audioContext.state ===
            "suspended"
        ) {

            await audioContext.resume();
        }
    }


    recorder.start(1000);

    /*
      Start both as close together as possible.
    */

    const startPromise =
        sourceVideo.play();

    if (musicFile) {
        await music.play();
    }

    await startPromise;


    /*
      Recording loop.
    */

    await new Promise(
        (resolve) => {

            let lastUpdate = 0;

            function recordLoop() {

                if (stopRequested) {

                    try {
                        recorder.stop();
                    } catch (_) {}

                    resolve();
                    return;
                }


                if (sourceVideo.ended) {

                    try {
                        recorder.stop();
                    } catch (_) {}

                    resolve();
                    return;
                }


                drawFrame();


                const duration =
                    sourceVideo.duration;

                const current =
                    sourceVideo.currentTime;

                if (
                    duration &&
                    Number.isFinite(duration)
                ) {

                    const percent =
                        (current / duration) *
                        45;

                    setProgress(percent);


                    const now =
                        performance.now();

                    if (
                        now - lastUpdate >
                        500
                    ) {

                        setStatus(
                            exportStatus,
                            "🎬 Rendering video: " +
                            Math.round(
                                percent / 45 * 100
                            ) +
                            "%"
                        );

                        lastUpdate = now;
                    }
                }


                requestAnimationFrame(
                    recordLoop
                );
            }

            recordLoop();
        }
    );


    sourceVideo.pause();

    if (musicFile) {
        music.pause();
    }


    const webmBlob =
        await finished;


    /*
      Stop tracks.
    */

    canvasStream
        .getTracks()
        .forEach(
            track =>
                track.stop()
        );

    if (audioStream) {

        audioStream
            .getTracks()
            .forEach(
                track =>
                    track.stop()
            );
    }

    if (audioContext) {

        try {
            await audioContext.close();
        } catch (_) {}
    }


    return webmBlob;
}


