/* =========================================================
   DRAW TEXT
========================================================= */

function drawText() {

    const text =
        textInput.value.trim();

    if (!text) {
        return;
    }

    const size =
        Number(textSize.value);

    const font =
        fontSelect.value;

    const x =
        canvas.width / 2;

    const y =
        canvas.height - 70;

    ctx.save();

    ctx.font =
        `700 ${size}px "${font}"`;

    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    if (currentTextStyle === "shadow") {

        ctx.shadowColor =
            "rgba(0,0,0,.9)";

        ctx.shadowBlur = 15;

        ctx.shadowOffsetX = 7;
        ctx.shadowOffsetY = 7;

        ctx.fillStyle = "#ffffff";

        ctx.fillText(
            text,
            x,
            y
        );
    }

    else if (currentTextStyle === "outline") {

        ctx.shadowColor =
            "transparent";

        ctx.lineWidth =
            Math.max(4, size / 12);

        ctx.strokeStyle =
            "#000000";

        ctx.strokeText(
            text,
            x,
            y
        );

        ctx.fillStyle =
            "#ffffff";

        ctx.fillText(
            text,
            x,
            y
        );
    }

    else if (currentTextStyle === "glow") {

        ctx.shadowColor =
            "#00eaff";

        ctx.shadowBlur = 25;

        ctx.fillStyle =
            "#ffffff";

        ctx.fillText(
            text,
            x,
            y
        );
    }

    else if (currentTextStyle === "3d") {

        ctx.shadowColor =
            "transparent";

        ctx.fillStyle =
            "#111111";

        for (let i = 8; i >= 1; i--) {

            ctx.fillText(
                text,
                x + i,
                y + i
            );
        }

        ctx.fillStyle =
            "#ffffff";

        ctx.fillText(
            text,
            x,
            y
        );
    }

    else if (currentTextStyle === "gradient") {

        const gradient =
            ctx.createLinearGradient(
                0,
                0,
                canvas.width,
                0
            );

        gradient.addColorStop(
            0,
            "#ff0066"
        );

        gradient.addColorStop(
            0.5,
            "#00eaff"
        );

        gradient.addColorStop(
            1,
            "#fff000"
        );

        ctx.fillStyle =
            gradient;

        ctx.fillText(
            text,
            x,
            y
        );
    }

    else {

        ctx.shadowColor =
            "transparent";

        ctx.fillStyle =
            "#ffffff";

        ctx.fillText(
            text,
            x,
            y
        );
    }

    ctx.restore();
}


/* =========================================================
   DRAW VIDEO FRAME
========================================================= */

function drawFrame() {

    if (!sourceVideo.videoWidth) {
        return;
    }

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.save();

    ctx.filter =
        getFilter();

    ctx.drawImage(
        sourceVideo,
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.restore();

    drawText();
}


